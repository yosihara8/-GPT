# ===== アプリ基本設定 =====
# 紹介URL・メール内リンク・Stripeの戻り先URLはすべてこの値から組み立てます
NEXT_PUBLIC_APP_URL=https://sagamap.jp

# ===== データベース（PostgreSQL + PostGIS）=====
DATABASE_URL=postgres://sagamap:sagamap@localhost:5432/sagamap

# ===== 認証（NextAuth.js）=====
NEXTAUTH_URL=https://sagamap.jp
# `openssl rand -base64 32` で生成
NEXTAUTH_SECRET=change-me
# Google OAuth（顧客ログイン用・任意）
# 承認済みリダイレクトURI: https://sagamap.jp/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Google Maps Platform =====
# ブラウザ用（Maps JavaScript API / Directions / Distance Matrix / Visualization）
# HTTPリファラ制限で sagamap.jp/* に限定してください
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 任意: Cloud Console で作成したマップID（未設定でも動作します）
NEXT_PUBLIC_GOOGLE_MAP_ID=
# サーバー用（店舗登録時の住所→緯度経度 Geocoding API）
GOOGLE_MAPS_SERVER_KEY=

# ===== Stripe（サブスクリプション）=====
STRIPE_SECRET_KEY=sk_test_xxx
# Webhookエンドポイント: https://sagamap.jp/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 月額 3,980 円（通常）の Price ID
STRIPE_PRICE_STANDARD=price_xxx
# 月額 2,980 円（紹介10名達成割引）の Price ID
STRIPE_PRICE_DISCOUNT=price_yyy

# ===== メール（Resend）=====
RESEND_API_KEY=re_xxx
MAIL_FROM="SagaMap <noreply@sagamap.jp>"

# ===== 定期実行（週1回のクーポン通知メール）=====
# /api/cron/weekly-digest を Authorization: Bearer <CRON_SECRET> で呼び出します
CRON_SECRET=change-me

# ===== デモデータ =====
# DB が空のとき、デプロイ時にサンプル店舗・デモアカウントを投入します。
# 本番運用を始めるときは false にしてください。
SEED_DEMO_DATA=false

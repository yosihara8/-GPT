{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 0 * * 5"
    },
    {
      "path": "/api/cron/monthly-referrals",
      "schedule": "10 15 * * *"
    }
  ]
}
